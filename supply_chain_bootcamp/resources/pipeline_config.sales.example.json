{
  "catalog": "supply_chain",
  "schema": "supply_chain",
  "source_file_path": "/Volumes/supply_chain/supply_chain/raw_sample_files",
  "source_file_pattern": "sales_raw.jsonl",
  "file_type": "json",
  "bronze_destination_table": "bronze_sales",
  "schema_location": "/Volumes/supply_chain/supply_chain/raw_sample_files/_state/schemas/bronze_sales",
  "checkpoint_path": "/Volumes/supply_chain/supply_chain/raw_sample_files/_state/checkpoints/bronze_sales",
  "reader_options": {
    "multiLine": false
  },
  "autoloader_options": {
    "cloudFiles.inferColumnTypes": true,
    "cloudFiles.schemaEvolutionMode": "addNewColumns"
  },
  "write_options": {
    "output_mode": "append",
    "trigger_available_now": true
  },
  "silver": {
    "source_bronze_table": "bronze_sales",
    "silver_table": "silver_day_item_store_tyly",
    "custom_cleaner": "unnest_sales_items",
    "checkpoint_path": "/Volumes/supply_chain/supply_chain/raw_sample_files/_state/checkpoints/silver_sales",
    "scope": {
      "retailerid": 1,
      "countryid": 1,
      "customerid": 1001
    },
    "column_definitions": [
      { "target": "itemnbr",        "expr": "CAST(sku AS STRING)" },
      { "target": "storenbr",   "expr": "CAST(store_id AS STRING)" },
      { "target": "day",        "expr": "to_date(sale_timestamp)" },
      { "target": "channel_lvl",  "expr": "CAST(payment_method AS STRING)" },
      { "target": "posqty",     "expr": "CAST(sales_qty AS DOUBLE)" },
      { "target": "possales",   "expr": "CAST(sales_retail AS DOUBLE)" },
      { "target": "unitprice",  "expr": "CAST(unit_price AS DOUBLE)" }
    ]
  }
}
