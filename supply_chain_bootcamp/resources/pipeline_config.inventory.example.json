{
  "catalog": "supply_chain",
  "schema": "supply_chain",
  "source_file_path": "/Volumes/supply_chain/supply_chain/raw_sample_files",
  "source_file_pattern": "inventory_raw.jsonl",
  "file_type": "json",
  "bronze_destination_table": "bronze_inventory",
  "schema_location": "/Volumes/supply_chain/supply_chain/raw_sample_files/_state/schemas/bronze_inventory",
  "checkpoint_path": "/Volumes/supply_chain/supply_chain/raw_sample_files/_state/checkpoints/bronze_inventory",
  "job_run_id": null,
  "reader_options": {
    "multiLine": false
  },
  "autoloader_options": {
    "cloudFiles.inferColumnTypes": true,
    "cloudFiles.schemaEvolutionMode": "addNewColumns"
  },
  "write_options": {
    "output_mode": "append",
    "trigger_available_now": true
  },
  "silver": {
    "source_bronze_table": "bronze_inventory",
    "silver_table": "silver_day_item_store_tyly",
    "custom_cleaner": "clean_inventory_snapshots",
    "checkpoint_path": "/Volumes/supply_chain/supply_chain/raw_sample_files/_state/checkpoints/silver_inventory",
    "scope": {
      "retailerid": 1,
      "countryid": 1
    },
    "dimensions": [
      { "dimension": "item",  "key_parts_from": ["sku"] },
      { "dimension": "store", "key_parts_from": ["store_id"] }
    ],
    "column_definitions": [
      { "target": "day",        "expr": "to_date(latest_snapshot_time)" },
      { "target": "channelid",  "expr": "CAST(0 AS BIGINT)" },
      { "target": "customerid", "expr": "CAST(0 AS BIGINT)" },
      { "target": "onhandqty",  "expr": "CAST(stock_level AS DOUBLE)" },
      { "target": "instock",    "expr": "CASE WHEN status = 'IN_STOCK' THEN 1.0 ELSE 0.0 END" }
    ]
  }
}
